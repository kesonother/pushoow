# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL — start local DB with: docker compose up -d
DATABASE_URL=postgres://pushoow:pushoow@localhost:5432/pushoow

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:3000

# OAuth — leave empty to hide the provider. Do not invent credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
